# Copy to `.env` and adjust as needed.
# Only VITE_-prefixed vars are exposed to the client (see Vite docs).

# The catalogue shown in the app is chosen at runtime from the manifest
# public/datasets.json (the "Dataset" picker in the top bar). VITE_DATASET_FILE is
# only a FALLBACK: it synthesises a single dataset entry if that manifest can't be
# fetched. To add/rename datasets, edit public/datasets.json.
VITE_DATASET_FILE=nearby_stars_merged.csv
